# Copy this file to .env for local configuration.
DATABASE_URL=postgresql+psycopg://academia:academia_local@localhost:5432/academia_bid

AUTH_PROVIDER=local
# Only honored by LocalCurrentUserProvider. Never use this in an Entra deployment.
LOCAL_DEFAULT_USER_ID=dev-user-001
MEDIA_PROVIDER=local
LOCAL_MEDIA_URL=http://localhost:8000/media/demo.mp4

# Comma-separated list. Do not use a wildcard outside local development.
CORS_ORIGINS=http://localhost:3000

# Microsoft Entra ID / Graph, required only when AUTH_PROVIDER=entra.
# Never commit a real client secret.
AZURE_TENANT_ID=
AZURE_BACKEND_CLIENT_ID=
AZURE_BACKEND_CLIENT_SECRET=
AZURE_FRONTEND_CLIENT_ID=
AZURE_BACKEND_SCOPE=api://<backend-client-id>/access_as_user
SHAREPOINT_SITE_HOST=
SHAREPOINT_SITE_PATH=
