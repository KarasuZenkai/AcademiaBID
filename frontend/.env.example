NEXT_PUBLIC_API_URL=http://localhost:8000
# Use "local" only for the development selector. Set "entra" once MSAL is implemented.
NEXT_PUBLIC_AUTH_PROVIDER=local

# Required when NEXT_PUBLIC_AUTH_PROVIDER=entra.
NEXT_PUBLIC_AZURE_TENANT_ID=
NEXT_PUBLIC_AZURE_FRONTEND_CLIENT_ID=
NEXT_PUBLIC_AZURE_BACKEND_SCOPE=api://<backend-client-id>/access_as_user
